{
  "name": "cc3-clone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sprites:vehicles": "blender -b -P tools/blender/vehicles.py --",
    "sprites:weapons": "blender -b -P tools/blender/weapons.py --",
    "sprites:soldiers": "blender -b -P tools/blender/soldiers.py -- --jobs 4",
    "sprites:items": "blender -b -P tools/blender/items.py --",
    "sprites:sheets": "python3 tools/blender/contact_sheet.py",
    "sprites": "npm run sprites:soldiers && npm run sprites:items && npm run sprites:vehicles && npm run sprites:weapons",
    "sprites:menu": "blender -b -P tools/blender/menu.py --"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
